{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-tree-agent.local/schema/ai-review-policy.v2.json",
  "title": "AI Review Policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "minimum_accept_confidence",
    "max_tool_calls_per_role",
    "roles",
    "waivable_risk_codes",
    "hard_invariants"
  ],
  "properties": {
    "schema_version": {"const": "ai-review-policy.v2"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "minimum_accept_confidence": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "max_tool_calls_per_role": {"type": "integer", "minimum": 1, "maximum": 1000},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_subject_reviewer", "ai_qa_auditor", "ai_dispute_adjudicator"],
      "properties": {
        "ai_subject_reviewer": {"$ref": "#/$defs/rolePolicy"},
        "ai_qa_auditor": {"$ref": "#/$defs/rolePolicy"},
        "ai_dispute_adjudicator": {"$ref": "#/$defs/rolePolicy"}
      }
    },
    "waivable_risk_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "hard_invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    }
  },
  "$defs": {
    "rolePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_tools",
        "prompt_version",
        "prompt_text",
        "context_version",
        "context_scope"
      ],
      "properties": {
        "allowed_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["replay_search", "deterministic_validator"]}
        },
        "prompt_version": {"type": "string", "minLength": 1},
        "prompt_text": {"type": "string", "minLength": 1},
        "context_version": {"type": "string", "minLength": 1},
        "context_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
        }
      }
    }
  }
}
